{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bench score record",
  "description": "verify.py + process_metrics.py + judge 盲评共同产出；综合分由 report.py 合并时计算",
  "type": "object",
  "required": ["run_id", "verifier"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string" },
    "verifier": {
      "type": "object",
      "required": ["passed", "total", "score"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "log_excerpt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "process_signals": {
      "type": "object",
      "description": "L1 探测器信号快照（与 run.json process 段一致）",
      "additionalProperties": true
    },
    "judge": {
      "type": "object",
      "required": ["model", "rubric_version", "blind", "scores"],
      "properties": {
        "model": { "type": "string" },
        "rubric_version": { "type": "string" },
        "blind": { "type": "boolean" },
        "scores": {
          "type": "object",
          "required": ["code_quality", "planning", "discipline", "self_test"],
          "properties": {
            "code_quality": { "type": "number", "minimum": 0, "maximum": 100 },
            "planning": { "type": "number", "minimum": 0, "maximum": 100 },
            "discipline": { "type": "number", "minimum": 0, "maximum": 100 },
            "self_test": { "type": "number", "minimum": 0, "maximum": 100 },
            "comments": { "type": "string" },
            "flags": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "judge_usage": {
          "type": "object",
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "composite_inputs": {
      "type": "object",
      "description": "report.py 合成综合分的原子输入快照",
      "properties": {
        "verifier_score": { "type": "number" },
        "code_quality": { "type": "number" },
        "planning": { "type": "number" },
        "discipline": { "type": "number" },
        "self_test": { "type": "number" },
        "duration_s": { "type": "number" },
        "cost_usd": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
